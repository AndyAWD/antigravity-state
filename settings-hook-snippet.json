{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/save-state/scripts/state-check.mjs\" inject",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/save-state/scripts/state-check.mjs\" stop-guard",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
