{
  "hooks": {
    "agy-state": {
      "PreInvocation": [
        {
          "type": "command",
          "command": "node \"$HOME/.gemini/antigravity-cli/skills/agy-state/scripts/state-check.mjs\" inject",
          "timeout": 5
        }
      ],
      "Stop": [
        {
          "type": "command",
          "command": "node \"$HOME/.gemini/antigravity-cli/skills/agy-state/scripts/state-check.mjs\" stop-guard",
          "timeout": 5
        }
      ]
    }
  }
}
